{
  "name": "flow-one",
  "version": "0.3.0",
  "private": false,
  "description": "把 WorkBuddy（国内版 CodeBuddy / 国际版）与 OpenCode 免费档接进 Claude Code CLI 的本地反代：Anthropic Messages ⇄ OpenAI Chat Completions，零依赖。",
  "type": "module",
  "main": "./dist/src/server.js",
  "bin": {
    "flow-one": "./dist/cli.js",
    "fo": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "start": "node cli.ts",
    "build": "tsc -p tsconfig.build.json && node -e \"require('node:fs').copyFileSync('package.json', 'dist/package.json')\"",
    "test": "node --test",
    "check": "make check",
    "verify": "make verify",
    "types": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.ts\" \"cli.ts\" eslint.config.mjs",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.ts\" \"cli.ts\" eslint.config.mjs"
  },
  "engines": {
    "node": ">=22.18"
  },
  "keywords": [
    "claude-code",
    "workbuddy",
    "codebuddy",
    "anthropic",
    "openai",
    "proxy",
    "bridge",
    "llm"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/9Ashwin/flow-one.git"
  },
  "homepage": "https://github.com/9Ashwin/flow-one#readme",
  "bugs": {
    "url": "https://github.com/9Ashwin/flow-one/issues"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  }
}
